# Server-side variables for the n8n process. Internal hostnames vary by deployment.
SATRIA_API_BASE=http://127.0.0.1:8000
SATRIA_ADAPTER_URL=http://127.0.0.1:8787
SATRIA_COURIER_ADAPTER_URL=http://127.0.0.1:8788
SATRIA_N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/satria-notifications
SATRIA_INTERNAL_TOKEN=replace-with-a-random-secret-at-least-32-characters
SATRIA_ADAPTER_TOKEN=replace-with-another-random-secret-at-least-32-characters
SATRIA_COURIER_ADAPTER_TOKEN=replace-with-a-fourth-random-secret-at-least-32-characters
SATRIA_WEBHOOK_TOKEN=replace-with-a-third-random-secret-at-least-32-characters

# n8n 2.x can block $env access in expressions. This deployment uses $env only
# on a trusted, private n8n instance with no untrusted workflow editors.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Asia/Jakarta

# Set the same token in Laravel N8N_WEBHOOK_TOKEN and create an n8n Header Auth
# credential named X-Satria-Webhook-Token. Do not store it inside workflow JSON.
