# Run one instance for OPS_ADMIN on port 8787 and a second for COURIER on port 8788.
# Use separate ADAPTER_TOKEN, SESSION_FILE, and LEDGER_FILE values.
# Development: MOCK performs no Telegram login or network send.
ADAPTER_MODE=MOCK
HOST=127.0.0.1
PORT=8787
SENDER_PROFILE=OPS_ADMIN
ADAPTER_TOKEN=replace-with-a-random-secret-at-least-32-characters
LARAVEL_API_BASE=http://127.0.0.1:8000
LARAVEL_INTERNAL_TOKEN=replace-with-another-random-secret-at-least-32-characters

# LIVE only; never commit real values or the encrypted session file.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SESSION_ENCRYPTION_KEY=
SESSION_FILE=./secrets/telegram.session.enc
