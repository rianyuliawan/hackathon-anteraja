server {
    listen 80;
    server_name hackathon-anteraja.rianyuliawan.my.id;
    root /srv/hackathon-anteraja/apps/ops/dist;
    index index.html;
    client_max_body_size 8m;

    location ~ ^/(api/|sanctum/|login$|logout$|register$|up$) {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /manifest.webmanifest { types { application/manifest+json webmanifest; } }

    location / { try_files $uri $uri/ /index.html; }
    location ~ /\.(?!well-known).* { deny all; }
}
