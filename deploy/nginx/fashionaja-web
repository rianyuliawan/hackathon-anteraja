server {
    listen 80;
    server_name katalog-fashionaja.rianyuliawan.my.id;
    root /srv/hackathon-anteraja/apps/catalog/dist;
    index index.html;

    location = /manifest.webmanifest { types { application/manifest+json webmanifest; } }

