[Unit]
Description=Anteraja Telegram admin adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rian
Group=rian
WorkingDirectory=/srv/hackathon-anteraja/integrations/telegram-adapter
ExecStart=/usr/bin/node --env-file=.env src/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
